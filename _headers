# Netlify _headers — Carmit Therapy Site
# Security + caching headers for all routes.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site
  X-DNS-Prefetch-Control: off
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), sync-xhr=(), usb=(), web-share=(self), xr-spatial-tracking=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; frame-src https://www.google.com https://maps.google.com; form-action 'self' https://script.google.com; manifest-src 'self'; media-src 'none'; worker-src 'none'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Notes on the CSP above:
#   script-src 'self'      — every script now lives in /js/*.js. There are no
#                            inline <script> blocks and no inline event handlers
#                            left on the site, so 'unsafe-inline' was dropped.
#                            That is the single biggest XSS mitigation here.
#   font-src 'self'        — fonts are self-hosted in /fonts, so Google's font
#                            domains were removed from the policy entirely.
#   img-src 'self' data:   — no remote images are loaded; the SVG cursors in the
#                            accessibility widget are data: URIs.
#   style-src 'unsafe-inline' is still required: the pages carry a handful of
#                            inline style="" attributes.

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS and JS are requested with a ?v= query string, so a long immutable cache is
# safe — bump the version in the HTML whenever these files change.
/style.css
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/image/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json; charset=utf-8

/llms.txt
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
